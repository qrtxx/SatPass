# Copy to .env and fill in. .env is git-ignored; never commit real passwords.
DATABASE_URL=postgresql+psycopg://satpass:CHANGE_ME@localhost:5432/satpass
# Used by pytest only. The tests rebuild this database from the migrations, so never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://satpass:CHANGE_ME@localhost:5432/satpass_test
